{
  "name": "jeely/jeely",
  "description": "A personal module for developing the Telegram bot in PHP",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.5",
    "corneltek/getoptionkit": "^2.7",
    "revolt/event-loop": "^1.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^6.4|^7.0"
  },
  "autoload": {
    "psr-4": {
      "Jeely\\": "src/Jeely/",
      "Examples\\": "examples/"
    },
    "files": [
      "src/functions.php"
    ]
  }
}
